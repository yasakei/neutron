// Test classes and OOP
say("=== Testing Classes and OOP ===");

// Test 1: Simple class definition
class Person {
    var string name;
    var int age;
    
    fun initialize(string n, int a) -> int {
        this.name = n;
        this.age = a;
    }
    
    fun greet() -> int {
        say("Hello, I am " + this.name);
    }
    
    fun getAge() -> int {
        return this.age;
    }
}

var object person = Person("Alice", 30);
person.greet();
var int age = person.getAge();
if (age == 30) {
    say("✓ Class definition and methods work");
} else {
    say("✗ Class methods failed");
}

// Test 2: Class with this keyword
class Counter {
    var int count;
    
    fun initialize() -> int {
        this.count = 0;
    }
    
    fun increment() -> int {
        this.count = this.count + 1;
        return this.count;
    }
    
    fun getValue() -> int {
        return this.count;
    }
}

var object counter = Counter();
counter.initialize();
var int val1 = counter.increment();
var int val2 = counter.increment();
if (val1 == 1 and val2 == 2) {
    say("✓ This keyword and state management work");
} else {
    say("✗ This keyword failed");
}

// Test 3: Multiple instances
var object counter1 = Counter();
counter1.initialize();
var object counter2 = Counter();
counter2.initialize();
counter1.increment();
counter1.increment();
counter2.increment();
var int c1 = counter1.getValue();
var int c2 = counter2.getValue();
if (c1 == 2 and c2 == 1) {
    say("✓ Multiple instances work independently");
} else {
    say("✗ Multiple instances failed");
}

// Test 4: Class with calculations
class Rectangle {
    var int width;
    var int height;
    
    fun initialize(int w, int h) -> int {
        this.width = w;
        this.height = h;
    }
    
    fun area() -> int {
        return this.width * this.height;
    }
}

var object rect = Rectangle(5, 3);
var int area = rect.area();
if (area == 15) {
    say("✓ Class methods with calculations work");
} else {
    say("✗ Class calculations failed");
}

say("\n=== All class and OOP tests passed ===");
