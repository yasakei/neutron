// Test Type Annotations (Strict Mode)
// In strict mode, ALL variables MUST have type annotations

say("=== Type Annotation Tests (Strict Mode) ===");

// Test 1: Basic type annotations - REQUIRED in strict mode
say("\n1. Basic type annotations (required):");
var int x = 42;
say("int x = 42: " + x);

var string name = "Alice";
say("string name = 'Alice': " + name);

var float pi = 3.14159;
say("float pi = 3.14159: " + pi);

var bool isActive = true;
say("bool isActive = true: " + isActive);

// Test 2: Type annotations with arrays - REQUIRED
say("\n2. Type annotations with arrays:");
var array numbers = [1, 2, 3, 4, 5];
say("array numbers: " + numbers);

// Test 3: Type annotations with objects - REQUIRED
say("\n3. Type annotations with objects:");
var object person = {"name": "Bob", "age": 30};
say("object person: " + person);

// Test 4: Type annotations in for loops - REQUIRED
say("\n4. Type annotations in loops:");
for (var int i = 0; i < 5; i = i + 1) {
    say("Loop iteration " + i);
}

// Test 5: Multiple typed declarations
say("\n5. Multiple typed declarations:");
var string firstName = "John";
var string lastName = "Doe";
var int age = 25;
var bool isStudent = false;
say("Name: " + firstName + " " + lastName);
say("Age: " + age);
say("Student: " + isStudent);

// Test 6: Typed functions
say("\n6. Typed functions:");
fun add(int a, int b) -> int {
    return a + b;
}
var int sum = add(5, 10);
say("add(5, 10) = " + sum);

// Test 7: Typed classes
say("\n7. Typed classes:");
class Person {
    var string name;
    var int age;
    
    fun init(string n, int a) -> int {
        this.name = n;
        this.age = a;
        return a;
    }
    
    fun getName() -> string {
        return this.name;
    }
}

var object p = Person();
p.init("Charlie", 25);
say("Person: " + p.getName());

say("\n=== All Type Annotation Tests Complete ===");
