
say("=== Deep GC Test ===");

class Node {
    var int next;
    fun initialize(int n) -> int {
        this.next = n;
    }
}

var object head;
say("Building deep list...");
// 20000 depth might be enough to crash C++ stack if recursive
for (var int i = 0; i < 20000; i = i + 1) {
    head = Node(head);
}
say("List built. Depth: 20000");

say("Triggering GC...");
// Allocate to trigger GC
var array arr = [];
for (var int i = 0; i < 10000; i = i + 1) {
    arr.push(i);
}
say("GC survived!");
