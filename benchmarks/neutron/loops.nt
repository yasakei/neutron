// Loop operations benchmark in Neutron

fun sumWithForLoop(n) {
    var int total = 0;
    var int i = 0;
    while (i < n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fun sumWithWhileLoop(n) {
    var int total = 0;
    var int i = 0;
    while (i < n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}

fun nestedLoops(depth, size) {
    var int count = 0;
    var int i = 0;
    while (i < depth) {
        var int j = 0;
        while (j < size) {
            var int k = 0;
            while (k < size) {
                count = count + 1;
                k = k + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return count;
}

// Perform loop operations
var int forResult = sumWithForLoop(100000);
var int whileResult = sumWithWhileLoop(100000);
var int nestedResult = nestedLoops(10, 50);

say("Loops: for=${forResult} while=${whileResult} nested=${nestedResult}");