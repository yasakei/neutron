
// Object instantiation benchmark
class Point {
    fun initialize(int x, int y) -> int {
        this.x = x;
        this.y = y;
    }
    
    fun dist() -> int {
        return this.x * this.x + this.y * this.y;
    }
}

var int sum = 0;

for (var int i = 0; i < 100000; i = i + 1) {
    var object p = Point(i, i + 1);
    sum = sum + p.dist();
}

say("Object result: " + sum);
