// Fibonacci benchmark in Neutron (iterative version)

fun fibonacci(n) {
    if (n <= 1) {
        return n;
    }
    
    var int a = 0;
    var int b = 1;
    var int i = 2;
    while (i <= n) {
        var int temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
    return b;
}

// Calculate fibonacci of 35 (reasonable time for benchmarking)
var int result = fibonacci(35);
say(result);