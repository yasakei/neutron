// Tree Traversal benchmark in Neutron

class TreeNode {
    var int val;
    var int left;
    var int right;
    
    fun initialize(int val) -> int {
        this.val = val;
        this.left = nil;
        this.right = nil;
    }
}

fun buildTree(depth, val) {
    if (depth <= 0) {
        return nil;
    }
    
    var object node = TreeNode(val);
    node.left = buildTree(depth - 1, val * 2 + 1);
    node.right = buildTree(depth - 1, val * 2 + 2);
    
    return node;
}

fun inorderSum(node) {
    if (node == nil) {
        return 0;
    }
    var int sum = inorderSum(node.left);
    sum = sum + node.val;
    sum = sum + inorderSum(node.right);
    return sum;
}

fun countNodes(node) {
    if (node == nil) {
        return 0;
    }
    return 1 + countNodes(node.left) + countNodes(node.right);
}

// Build tree of depth 15
var int root = buildTree(15, 0);

// Count and sum
var int nodeCount = countNodes(root);
var int totalSum = inorderSum(root);

say("Tree nodes: ${nodeCount}, Sum: ${totalSum}");
