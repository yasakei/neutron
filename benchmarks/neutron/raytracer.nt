// Ray Tracer benchmark in Neutron
// Simple ray-sphere intersection - just check if ray hits sphere at origin

// Single sphere at origin with radius 10
var int sphere_x = 0;
var int sphere_y = 0;
var int sphere_z = 0;
var int sphere_r = 10;

fun sqrtApprox(x) {
    if (x <= 0) return 0;
    var int guess = x / 2;
    var int i = 0;
    while (i < 20) {
        guess = (guess + x / guess) / 2;
        i = i + 1;
    }
    return guess;
}

fun sphereIntersect(sx, sy, sz, sr, ox, oy, oz, dx, dy, dz) {
    var int ocx = ox - sx;
    var int ocy = oy - sy;
    var int ocz = oz - sz;
    
    var int a = dx * dx + dy * dy + dz * dz;
    var int b = 2 * (ocx * dx + ocy * dy + ocz * dz);
    var int c = ocx * ocx + ocy * ocy + ocz * ocz - sr * sr;
    
    var int disc = b * b - 4 * a * c;
    if (disc < 0) {
        return -1;
    }
    return (-b - sqrtApprox(disc)) / (2 * a);
}

fun render(width, height) {
    var int pixelsHit = 0;
    
    var int y = 0;
    while (y < height) {
        var int x = 0;
        while (x < width) {
            // Normalized device coordinates
            var int nx = (x / width - 0.5) * 2;
            var int ny = (y / height - 0.5) * 2;
            
            // Ray from (0,0,-20) in direction (nx, ny, 1) normalized
            var int dirLen = sqrtApprox(nx * nx + ny * ny + 1);
            var int rdx = nx / dirLen;
            var int rdy = ny / dirLen;
            var int rdz = 1 / dirLen;
            
            var int t = sphereIntersect(sphere_x, sphere_y, sphere_z, sphere_r, 0, 0, -20, rdx, rdy, rdz);
            if (t > 0.001) {
                pixelsHit = pixelsHit + 1;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    
    return pixelsHit;
}

// Render
var int width = 100;
var int height = 100;
var int pixels = render(width, height);
say("Rendered ${width}x${height}, lit pixels: ${pixels}");
