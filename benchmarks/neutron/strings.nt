// String operations benchmark in Neutron

fun reverseString(s) {
    var string result = "";
    var int len = s.length;
    var int i = 0;
    while (i < len) {
        result = s[i] + result;
        i = i + 1;
    }
    return result;
}

fun countOccurrences(haystack, needle) {
    // needle should be single character for this simple implementation
    if (needle.length != 1) {
        return 0;
    }
    
    var int count = 0;
    var int hayLen = haystack.length;
    var int needleChar = needle[0];
    var int i = 0;
    while (i < hayLen) {
        if (haystack[i] == needleChar) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

fun simpleConcatenate(base, addition, times) {
    var string result = base;
    var int i = 0;
    while (i < times) {
        result = result + addition;
        i = i + 1;
    }
    return result;
}

// Create a long string for testing
var string longString = "";
var int j = 0;
var int iterations = 100;  // Reduced from 1000 for better performance
while (j < iterations) {
    longString = longString + "Neutron programming language is fast and efficient. ";
    j = j + 1;
}

// Perform string operations
var array reversed = reverseString(longString);
var int charCount = countOccurrences(longString, "a");
var int concatenated = simpleConcatenate("", "Hello World from Neutron! ", 50);

// Output result
say("String ops: len=${longString.length} rev=${reversed.length} count=${charCount}");