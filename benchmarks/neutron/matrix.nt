// Matrix operations benchmark in Neutron

fun multiplyMatrices(a, b, size) {
    var array result = [];
    var int i = 0;
    while (i < size) {
        var array row = [];
        var int j = 0;
        while (j < size) {
            var int sum = 0;
            var int k = 0;
            while (k < size) {
                sum = sum + a[i][k] * b[k][j];
                k = k + 1;
            }
            row.push(sum);
            j = j + 1;
        }
        result.push(row);
        i = i + 1;
    }
    return result;
}

fun createMatrix(size) {
    var array matrix = [];
    var int i = 0;
    while (i < size) {
        var array row = [];
        var int j = 0;
        while (j < size) {
            row.push(i * size + j + 1);
            j = j + 1;
        }
        matrix.push(row);
        i = i + 1;
    }
    return matrix;
}

// Create 20x20 matrices
var int size = 20;
var int matrixA = createMatrix(size);
var int matrixB = createMatrix(size);

// Multiply matrices
var array result = multiplyMatrices(matrixA, matrixB, size);
say("Matrix ${result.length}x${result[0].length} = ${result[0][0]}");