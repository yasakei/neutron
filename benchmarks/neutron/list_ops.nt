// Array/List operations benchmark
// Tests array creation, access, and manipulation

use arrays;

// Create and populate a large array
var array numbers = arrays.new();
for (var int i = 0; i < 1000; i = i + 1) {
    arrays.push(numbers, i);
}
say("Created array with 1000 elements");

// Access elements
var int sum = 0;
var int len = arrays.length(numbers);
for (var int i = 0; i < len; i = i + 1) {
    var int val = arrays.at(numbers, i);
    sum = sum + val;
}
say("Sum of all numbers: " + sum);

// Count even numbers (manual filter)
var int even_count = 0;
for (var int i = 0; i < len; i = i + 1) {
    var int val = arrays.at(numbers, i);
    if (val % 2 == 0) {
        even_count = even_count + 1;
    }
}
say("Filtered " + even_count + " even numbers");

// Find specific element (manual find)
var int found = -1;
for (var int i = 0; i < len; i = i + 1) {
    var int val = arrays.at(numbers, i);
    if (val == 500) {
        found = val;
        break;
    }
}
say("Found element: " + found);

// Sorting
var array unsorted = [64, 34, 25, 12, 22, 11, 90];
var int sorted_arr = arrays.sort(unsorted);
say("Sorted array: " + arrays.join(sorted_arr, ", "));

// Reverse
var int reversed = arrays.reverse(sorted_arr);
say("Reversed array: " + arrays.join(reversed, ", "));
