// Mandelbrot Set benchmark in Neutron

fun mandelbrot(cx, cy, maxIter) {
    var int zx = 0;
    var int zy = 0;
    var int n = 0;
    var int tmp;

    while (zx * zx + zy * zy <= 4 and n < maxIter) {
        tmp = zx * zx - zy * zy + cx;
        zy = 2 * zx * zy + cy;
        zx = tmp;
        n = n + 1;
    }
    return n;
}

fun linspace(start, stop, num) {
    var array result = [];
    var int step = 0;
    if (num > 1) {
        step = (stop - start) / (num - 1);
    }
    var int i = 0;
    while (i < num) {
        result.push(start + step * i);
        i = i + 1;
    }
    return result;
}

fun mandelbrotSet(xmin, xmax, ymin, ymax, width, height, maxIter) {
    var array r1 = linspace(xmin, xmax, width);
    var array r2 = linspace(ymin, ymax, height);
    var int count = 0;
    
    var int i = 0;
    while (i < width) {
        var int x = r1[i];
        var int j = 0;
        while (j < height) {
            var int c = mandelbrot(x, r2[j], maxIter);
            if (c == maxIter) {
                count = count + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return count;
}

// Calculate mandelbrot set
var int width = 200;
var int height = 200;
var float xmin = -2.0;
var float xmax = 1.0;
var float ymin = -1.5;
var float ymax = 1.5;
var int maxIter = 100;

var int count = mandelbrotSet(xmin, xmax, ymin, ymax, width, height, maxIter);
say("Mandelbrot points: ${count}");
